{

  "name": "node-pluginsmanager",
  "version": "3.8.1",
  "description": "A plugins manager.",

  "type": "commonjs",
  "typings": "./lib/cjs/main.d.cts",
  "main": "./lib/cjs/main.cjs",

  "exports": {
    ".": {
      "require": {
        "types": "./lib/cjs/main.d.cts",
        "default": "./lib/cjs/main.cjs"
      }
    }
  },

  "scripts": {

    "lint-back": "npx eslint --config .eslintrc-back.js --ext .ts,.cts,.mts ./lib/src/**/*",
    "lint-tests": "npx eslint --config .eslintrc-tests.js --ext .js,.cjs,.mjs ./test/**/*.js",
    "lint": "npm run lint-back && npm run lint-tests",

    "clean-back": "npx rimraf ./lib/cjs",
    "clean": "npm run clean-back",

    "build-back": "npm run clean-back && npx tsc --project ./tsconfig.json",
    "build": "npm run build-back",

    "check-node-engine": "npx check-node-engine",
    "check-requires": "npx used-deps-analyzer ./package.json ./lib/src --no-dev",
    "check-updates": "npx check-version-modules --no-fail-at-major --fail-at-minor --fail-at-patch",
    "unit-tests": "npx c8 --reporter=text-summary --all --include \"lib/src/**/*.ts\" --include \"lib/src/**/*.cts\" --extension .ts --extension .cts --check-coverage --statements 95 --branches 95 --functions 95 --lines 95 mocha --require ./test/register.js",
    "unit-tests-local": "npx c8 --reporter=html --reporter=text --all --include \"lib/src/**/*.ts\" --include \"lib/src/**/*.cts\" --extension .ts --extension .cts mocha --require ./test/register.js",

    "tests": "npm run lint && npm run check-node-engine && npm run check-requires && npm run check-updates && npm run build && npm run unit-tests"

  },

  "files": [
    "/lib/cjs"
  ],
  "engines": {
    "node": ">=22.23.4"
  },

  "dependencies": {
    "check-node-engine": "1.2.1",
    "check-version-modules": "2.5.2",
    "semver": "7.8.5"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/node": "26.6.5",
    "@types/semver": "7.8.0",
    "@types/socket.io": "3.0.2",
    "@types/ws": "8.18.2",
    "c8": "12.0.0",
    "eslint-plugin-personnallinter": "git+ssh://git@github.com/Psychopoulet/eslint-plugin-personnallinter",
    "express": "5.3.0",
    "husky": "9.1.7",
    "mocha": "12.0.3",
    "node-pluginsmanager-plugin": "7.4.5",
    "proxyquire": "2.1.3",
    "rimraf": "6.1.3",
    "socket.io": "4.8.4",
    "typescript": "6.0.3",
    "used-deps-analyzer": "0.4.1",
    "ws": "8.22.0"
  },

  "keywords": [
    "plugin",
    "manage",
    "gestion"
  ],
  "author": "Sébastien VIDAL",
  "license": "ISC",

  "homepage": "https://github.com/Psychopoulet/node-pluginsmanager#readme",
  "repository": {
    "type": "git",
    "url": "git://github.com/Psychopoulet/node-pluginsmanager.git"
  },
  "bugs": {
    "url": "https://github.com/Psychopoulet/node-pluginsmanager/issues"
  }

}
